  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "test": "rm -rf build-test && node esbuild.config.mjs test && node --test \"build-test/**/*.test.mjs\"",
    "test:e2e": "node esbuild.config.mjs production && node esbuild.config.mjs e2e && vscode-test",
    "package": "node esbuild.config.mjs production && vsce package --no-dependencies --allow-missing-repository --skip-license --out monolog.vsix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.0.0",
    "typescript": "^5.6.0"
  }
}
