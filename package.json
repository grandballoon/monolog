{
  "name": "monolog",
  "displayName": "Monolog",
  "description": "Write down what you assume about the code you are reading, and have each assumption checked, without touching the file.",
  "version": "0.1.0",
  "publisher": "lukeconley",
  "icon": "media/icon.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "monolog.addAssumption",
        "title": "Add Assumption About Code",
        "category": "Monolog",
        "icon": "$(lightbulb)"
      },
      {
        "command": "monolog.submitAssumption",
        "title": "Record Assumption",
        "category": "Monolog"
      },
      {
        "command": "monolog.addScratchNote",
        "title": "Add Note About Code",
        "category": "Monolog",
        "icon": "$(note)"
      },
      {
        "command": "monolog.submitScratchNote",
        "title": "Save Note",
        "category": "Monolog"
      },
      {
        "command": "monolog.addFileNote",
        "title": "Add Note About File",
        "category": "Monolog",
        "icon": "$(file-text)"
      },
      {
        "command": "monolog.cancelNewAssumption",
        "title": "Cancel",
        "category": "Monolog"
      },
      {
        "command": "monolog.editClaim",
        "title": "Edit Assumption",
        "category": "Monolog",
        "icon": "$(edit)"
      },
      {
        "command": "monolog.saveClaim",
        "title": "Save and Check",
        "category": "Monolog"
      },
      {
        "command": "monolog.cancelEdit",
        "title": "Cancel",
        "category": "Monolog"
      },
      {
        "command": "monolog.setNoteTitle",
        "title": "Set Title",
        "category": "Monolog",
        "icon": "$(text-size)"
      },
      {
        "command": "monolog.recheck",
        "title": "Check Again",
        "category": "Monolog",
        "icon": "$(refresh)"
      },
      {
        "command": "monolog.resolve",
        "title": "Mark Resolved",
        "category": "Monolog",
        "icon": "$(check)"
      },
      {
        "command": "monolog.reopen",
        "title": "Reopen",
        "category": "Monolog",
        "icon": "$(debug-restart)"
      },
      {
        "command": "monolog.delete",
        "title": "Delete Assumption",
        "category": "Monolog",
        "icon": "$(trash)"
      },
      {
        "command": "monolog.setTagColor",
        "title": "Set Tag Colour…",
        "category": "Monolog",
        "icon": "$(symbol-color)"
      },
      {
        "command": "monolog.showTagColors",
        "title": "Show Tag Colours",
        "category": "Monolog",
        "icon": "$(eye-closed)"
      },
      {
        "command": "monolog.hideTagColors",
        "title": "Hide Tag Colours",
        "category": "Monolog",
        "icon": "$(eye)"
      },
      {
        "command": "monolog.setApiKey",
        "title": "Set Anthropic API Key",
        "category": "Monolog"
      },
      {
        "command": "monolog.clearApiKey",
        "title": "Remove Anthropic API Key",
        "category": "Monolog"
      },
      {
        "command": "monolog.pruneDeleted",
        "title": "Prune Assumptions for Deleted Files",
        "category": "Monolog"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "monolog.addAssumption",
          "when": "resourceScheme == file",
          "group": "monolog@1"
        },
        {
          "command": "monolog.addScratchNote",
          "when": "resourceScheme == file",
          "group": "monolog@2"
        },
        {
          "command": "monolog.addFileNote",
          "when": "resourceScheme == file",
          "group": "monolog@3"
        }
      ],
      "commandPalette": [
        {
          "command": "monolog.addAssumption",
          "when": "resourceScheme == file"
        },
        {
          "command": "monolog.addScratchNote",
          "when": "resourceScheme == file"
        },
        {
          "command": "monolog.addFileNote",
          "when": "resourceScheme == file"
        },
        {
          "command": "monolog.showTagColors",
          "when": "!monolog.tagColors"
        },
        {
          "command": "monolog.hideTagColors",
          "when": "monolog.tagColors"
        },
        {
          "command": "monolog.submitAssumption",
          "when": "false"
        },
        {
          "command": "monolog.submitScratchNote",
          "when": "false"
        },
        {
          "command": "monolog.cancelNewAssumption",
          "when": "false"
        },
        {
          "command": "monolog.editClaim",
          "when": "false"
        },
        {
          "command": "monolog.saveClaim",
          "when": "false"
        },
        {
          "command": "monolog.cancelEdit",
          "when": "false"
        },
        {
          "command": "monolog.setNoteTitle",
          "when": "false"
        },
        {
          "command": "monolog.recheck",
          "when": "false"
        },
        {
          "command": "monolog.resolve",
          "when": "false"
        },
        {
          "command": "monolog.reopen",
          "when": "false"
        },
        {
          "command": "monolog.delete",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "monolog.submitAssumption",
          "group": "inline@1",
          "when": "commentController == monolog && commentThread != draft-scratch && commentThread != draft-file"
        },
        {
          "command": "monolog.submitScratchNote",
          "group": "inline@2",
          "when": "commentController == monolog && commentThread != draft-assumption"
        },
        {
          "command": "monolog.cancelNewAssumption",
          "group": "inline@3",
          "when": "commentController == monolog"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "monolog.setNoteTitle",
          "group": "navigation@1",
          "when": "commentController == monolog && commentThread =~ /^scratch/"
        },
        {
          "command": "monolog.recheck",
          "group": "navigation@1",
          "when": "commentController == monolog && commentThread =~ /^assumption/"
        },
        {
          "command": "monolog.resolve",
          "group": "navigation@2",
          "when": "commentController == monolog && commentThread =~ /^(assumption|scratch)$/"
        },
        {
          "command": "monolog.reopen",
          "group": "navigation@2",
          "when": "commentController == monolog && commentThread =~ /^(assumption|scratch)-resolved$/"
        },
        {
          "command": "monolog.delete",
          "group": "navigation@3",
          "when": "commentController == monolog && commentThread =~ /^(assumption|scratch)/"
        }
      ],
      "comments/comment/title": [
        {
          "command": "monolog.editClaim",
          "group": "inline@1",
          "when": "commentController == monolog && comment == claim"
        }
      ],
      "comments/comment/context": [
        {
          "command": "monolog.saveClaim",
          "group": "inline@1",
          "when": "commentController == monolog && comment == claim"
        },
        {
          "command": "monolog.cancelEdit",
          "group": "inline@2",
          "when": "commentController == monolog && comment == claim"
        }
      ],
      "editor/title": [
        {
          "command": "monolog.hideTagColors",
          "group": "navigation@90",
          "when": "resourceScheme == file && monolog.fileHasTagColors && monolog.tagColors"
        },
        {
          "command": "monolog.showTagColors",
          "group": "navigation@90",
          "when": "resourceScheme == file && monolog.fileHasTagColors && !monolog.tagColors"
        }
      ],
      "explorer/context": [
        {
          "command": "monolog.addFileNote",
          "group": "monolog@1",
          "when": "resourceScheme == file && !explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "Monolog",
      "properties": {
        "monolog.model": {
          "type": "string",
          "default": "claude-sonnet-5",
          "enum": [
            "claude-sonnet-5",
            "claude-opus-5",
            "claude-haiku-4-5"
          ],
          "enumDescriptions": [
            "Sonnet 5 — fast and capable (default).",
            "Opus 5 — the most careful reader; slower and costlier.",
            "Haiku 4.5 — cheapest; most likely to be confidently wrong."
          ],
          "markdownDescription": "The model that checks assumptions. Before reaching for a smaller model, try lowering `#monolog.effort#`: it keeps the model that is good at this and spends less thinking on it."
        },
        "monolog.effort": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "max",
            "xhigh",
            "high",
            "medium",
            "low"
          ],
          "enumDescriptions": [
            "Send no effort, which is the API's own default (high).",
            "The most thorough reading, at the highest cost.",
            "More thorough than the default.",
            "The API's default level, stated explicitly.",
            "Cheaper; a little less careful.",
            "Cheapest; least careful."
          ],
          "description": "How much thinking each check may spend. Ignored for Haiku 4.5, which does not take an effort level."
        },
        "monolog.demoMode": {
          "type": "boolean",
          "default": false,
          "description": "Record assumptions without sending them to Claude. They are saved and shown, but not checked."
        },
        "monolog.inlineSummary": {
          "type": "boolean",
          "default": true,
          "description": "Show each assumption's verdict and a short excerpt at the end of the last line it covers."
        }
      }
    },
    "colors": [
      {
        "id": "monolog.pendingBackground",
        "description": "Background of a span whose assumption has no verdict yet.",
        "defaults": {
          "light": "#7d766626",
          "dark": "#6b748133",
          "highContrast": null
        }
      },
      {
        "id": "monolog.pendingBorder",
        "description": "Underline of a span whose assumption has no verdict yet.",
        "defaults": {
          "light": "#7d7666",
          "dark": "#6b7481",
          "highContrast": "#ffffff"
        }
      },
      {
        "id": "monolog.wrongBackground",
        "description": "Background of a span whose assumption is wrong.",
        "defaults": {
          "light": "#b35a3029",
          "dark": "#cd744833",
          "highContrast": null
        }
      },
      {
        "id": "monolog.wrongBorder",
