          "light": "#b35a30",
          "dark": "#cd7448",
          "highContrast": "#cd7448"
        }
      },
      {
        "id": "monolog.impreciseBackground",
        "description": "Background of a span whose assumption is imprecise.",
        "defaults": {
          "light": "#c69a4533",
          "dark": "#c69a4533",
          "highContrast": null
        }
      },
      {
        "id": "monolog.impreciseBorder",
        "description": "Underline of a span whose assumption is imprecise.",
        "defaults": {
          "light": "#c69a45",
          "dark": "#c69a45",
          "highContrast": "#c69a45"
        }
      },
      {
        "id": "monolog.missingBackground",
        "description": "Background of a span whose assumption leaves out something that matters.",
        "defaults": {
          "light": "#4f74a826",
          "dark": "#6f9ac833",
          "highContrast": null
        }
      },
      {
        "id": "monolog.missingBorder",
        "description": "Underline of a span whose assumption leaves out something that matters.",
        "defaults": {
          "light": "#4f74a8",
          "dark": "#6f9ac8",
          "highContrast": "#6f9ac8"
        }
      },
      {
        "id": "monolog.solidBackground",
        "description": "Background of a span whose assumption holds.",
        "defaults": {
          "light": "#467d4f26",
          "dark": "#5f9e6b33",
          "highContrast": null
        }
      },
      {
        "id": "monolog.solidBorder",
        "description": "Underline of a span whose assumption holds.",
        "defaults": {
          "light": "#467d4f",
          "dark": "#5f9e6b",
          "highContrast": "#5f9e6b"
        }
      },
      {
        "id": "monolog.unverifiableBackground",
        "description": "Background of a span whose assumption cannot be settled from this file.",
        "defaults": {
          "light": "#7a5c9e24",
          "dark": "#a58bc633",
          "highContrast": null
        }
      },
      {
        "id": "monolog.unverifiableBorder",
        "description": "Underline of a span whose assumption cannot be settled from this file.",
        "defaults": {
          "light": "#7a5c9e",
          "dark": "#a58bc6",
          "highContrast": "#a58bc6"
        }
      },
      {
        "id": "monolog.scratchBackground",
        "description": "Background of a span with a scratch note.",
        "defaults": {
          "light": "#2f7f7a1f",
          "dark": "#4fb0a82b",
          "highContrast": null
        }
      },
      {
        "id": "monolog.scratchBorder",
        "description": "Underline of a span with a scratch note.",
        "defaults": {
          "light": "#2f7f7a",
          "dark": "#4fb0a8",
          "highContrast": "#4fb0a8"
        }
      },
      {
